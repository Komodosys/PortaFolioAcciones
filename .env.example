# Copia este fichero a `.env` y rellena la contrasena.
# El `.env` NO se versiona (ver .gitignore): contiene la contrasena de la base de datos.

# --- Base de datos ------------------------------------------------------------------------------
POSTGRES_DB=portafolio
POSTGRES_USER=portafolio

# Contrasena. Pon una larga y aleatoria. Solo se usa la PRIMERA vez que se crea la base: si la
# cambias despues aqui, la base de datos NO la cambia.
POSTGRES_PASSWORD=cambiame

# Puerto en el que se publica PostgreSQL, solo en la propia maquina (127.0.0.1).
PUERTO_POSTGRES=5432

# --- API ----------------------------------------------------------------------------------------
# Development muestra el documento OpenAPI en /openapi/v1.json y da errores detallados.
# En el despliegue definitivo, ponlo en Production.
ENTORNO_ASPNET=Development

# --- Porteria (Caddy) ---------------------------------------------------------------------------
# Puerto en el que respondera la aplicacion. Es la direccion que se abre en el navegador.
PUERTO_WEB=8080

# --- Primera cuenta de administrador -------------------------------------------------------------
# Se crea SOLA la primera vez que arranca la aplicacion, cuando todavia no hay ninguna cuenta.
# A partir de ahi, esta seccion no se vuelve a mirar: las demas cuentas las crea el administrador.
#
# EL USUARIO CON EL QUE SE ENTRA. Si se deja vacio, se usa `admin`.
ADMIN_USERNAME=admin
#
# La contrasena de esa primera cuenta. Si se deja VACIA, el arranque genera una y la enseña UNA SOLA VEZ
# en el registro, para no obligar a guardarla en un fichero:
#
#   docker compose logs api | findstr CONTRASENA
#
# En la aplicacion se entra con ADMIN_USERNAME y esta contrasena.
ADMIN_PASSWORD=cambiame-tambien

# --- Carpetas de datos en el host ---------------------------------------------------------------
# FUERA del contenedor y fuera del repositorio: se pueden copiar, inspeccionar y respaldar desde
# Windows sin entrar en Docker. Rutas relativas a este fichero.
DATOS_POSTGRES=../PortaFolioAcciones-datos/postgres
DATOS_CADDY=../PortaFolioAcciones-datos/caddy
