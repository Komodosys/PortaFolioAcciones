<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      xunit v3 compila el proyecto de pruebas como un EJECUTABLE que se ejecuta solo, mediante
      Microsoft.Testing.Platform. Se evita asi el "testhost" de VSTest, que necesita abrir un handle
      del proceso padre para vigilar su salida: eso falla en este equipo.
      La forma de ejecutar las pruebas esta en el README de la raiz.
    -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PortaFolioAcciones.Domain\PortaFolioAcciones.Domain.csproj" />
  </ItemGroup>

</Project>
